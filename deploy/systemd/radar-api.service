[Unit]
Description=Bridge Radar — REST + WebSocket API (Hono)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=radar
Group=radar
WorkingDirectory=/opt/bridge-radar/apps/api
EnvironmentFile=/opt/bridge-radar/.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=radar-api

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/bridge-radar/data
ProtectHome=true

[Install]
WantedBy=multi-user.target
